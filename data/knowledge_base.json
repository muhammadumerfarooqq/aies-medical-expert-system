  "diseases": {
    "pneumonia": {
      "name": "Pneumonia",
      "severity": "severe",
      "description": "Acute infection of the lungs (bacterial, viral or fungal). Cough, shortness of breath, fever, chest pain.",
      "treatment": [
        "See a doctor promptly.",
        "Antibiotics if bacterial (WHO preferred: amoxicillin), prescribed by a doctor.",
        "Hospital care for severe cases.",
        "Rest and plenty of fluids."
      ],
      "prevention": [
        "Vaccination (pneumococcal, Hib, measles, influenza, whooping cough)",
        "Frequent handwashing",
        "Reduce indoor air pollution",
        "Stop smoking",
        "Healthy diet"
      ],
      "sources": ["WHO"],
      "knowledge_type": "factual"
    },
    "dengue": {
      "name": "Dengue",
      "severity": "severe",
      "description": "Viral infection spread by Aedes mosquitoes. High fever with pain behind the eyes, aches, nausea, rash; lasts 2–7 days. Severe dengue is a medical emergency.",
      "treatment": [
        "No specific medicine.",
        "Rest.",
        "Drink plenty of fluids/electrolytes.",
        "Paracetamol for fever and pain.",
        "Do not take aspirin or ibuprofen (bleeding risk).",
        "See a doctor and watch for warning signs."
      ],
      "prevention": [
        "Repellents (DEET, IR3535, icaridin)",
        "Long sleeves and trousers",
        "Window screens and mosquito nets",
        "Cover water containers, drain standing water, discard tyres/containers"
      ],
      "sources": ["WHO", "CDC"],
      "knowledge_type": "factual"
    },
    "malaria": {
      "name": "Malaria",
      "severity": "severe",
      "description": "Parasitic disease (Plasmodium) spread by infected Anopheles mosquitoes. Fever, headache, chills. Always requires treatment with medicine.",
      "treatment": [
        "Confirm with a blood test (microscopy or rapid diagnostic test).",
        "Artemisinin-based combination therapy (ACT) prescribed by a doctor.",
        "Always requires medicine.",
        "Severe symptoms need emergency care."
      ],
      "prevention": [
        "Insecticide-treated bed nets",
        "Repellents after dusk",
        "Protective clothing and window screens",
        "Preventive medicine for travellers",
        "WHO-recommended vaccines (RTS,S, R21) for young children in high-transmission areas"
      ],
      "sources": ["WHO"],
      "knowledge_type": "factual"
    },
    "typhoid": {
      "name": "Typhoid",
      "severity": "moderate",
      "description": "Bacterial infection (Salmonella Typhi) spread through contaminated food and water. Prolonged high fever, abdominal pain, constipation or diarrhoea.",
      "treatment": [
        "Blood test to confirm.",
        "Antibiotics prescribed by a doctor, taken for the full course (antimicrobial resistance is common).",
        "Wash hands after toilet.",
        "Do not prepare food for others until cleared."
      ],
      "prevention": [
        "Safe (boiled/treated) water",
        "Adequate sanitation",
        "Eat thoroughly cooked, hot food",
        "Hand hygiene",
        "Typhoid conjugate vaccine"
      ],
      "sources": ["WHO"],
      "knowledge_type": "factual"
    },
    "influenza": {
      "name": "Influenza",
      "severity": "moderate",
      "description": "Acute viral respiratory infection. Sudden fever, dry cough, headache, muscle and joint pain, malaise.",
      "treatment": [
        "Rest, drink fluids, treat fever.",
        "Seek care if symptoms worsen.",
        "Antivirals as soon as possible for high-risk or severe cases (doctor-prescribed)."
      ],
      "prevention": [
        "Annual vaccination",
        "Wash hands regularly",
        "Cover coughs and sneezes",
        "Stay home when unwell",
        "Avoid touching eyes, nose and mouth"
      ],
      "sources": ["WHO"],
      "knowledge_type": "factual"
    },
    "common_cold": {
      "name": "Common Cold",
      "severity": "mild",
      "description": "Viral infection of the nose and throat. Sneezing, runny nose, sore throat; most people have no fever; resolves on its own.",
      "treatment": [
        "Rest and fluids.",
        "Saline nasal spray, humidifier, lozenges.",
        "Honey for cough (age 1+).",
        "OTC medicines only relieve symptoms.",
        "Antibiotics do not help.",
        "See a doctor if breathing is difficult, fever lasts more than 4 days, or symptoms last more than 10 days."
      ],
      "prevention": [
        "Wash hands",
        "Avoid touching face",
        "Avoid close contact with sick people",
        "Keep vaccines up to date"
      ],
      "sources": ["CDC"],
      "knowledge_type": "factual"
    }
  },
