  "rules": [
    {"id": "R1", "if": ["cough", "shortness_of_breath"], "then": "pneumonia_signs", "cf": 0.80, "priority": 30, "knowledge_type": "heuristic", "rationale": "Lower respiratory pattern", "source": "WHO"},
    {"id": "R2", "if": ["chest_pain"], "then": "pneumonia_signs", "cf": 0.50, "priority": 30, "knowledge_type": "heuristic", "rationale": "Chest pain listed for pneumonia", "source": "WHO"},
    {"id": "R3", "if": ["fever", "pneumonia_signs"], "then": "pneumonia", "cf": 0.85, "priority": 30, "knowledge_type": "heuristic", "rationale": "Fever + lower respiratory signs", "source": "WHO"},
    {"id": "R4", "if": ["rash", "pain_behind_eyes"], "then": "dengue_signs", "cf": 0.85, "priority": 30, "knowledge_type": "heuristic", "rationale": "Most specific dengue pair", "source": "WHO, CDC"},
    {"id": "R5", "if": ["body_aches", "nausea_vomiting"], "then": "dengue_signs", "cf": 0.60, "priority": 30, "knowledge_type": "heuristic", "rationale": "Dengue: aches + nausea/vomiting", "source": "WHO, CDC"},
    {"id": "R6", "if": ["bleeding_gums"], "then": "dengue_signs", "cf": 0.70, "priority": 30, "knowledge_type": "heuristic", "rationale": "Dengue warning sign", "source": "WHO, CDC"},
    {"id": "R7", "if": ["fever", "dengue_signs"], "then": "dengue", "cf": 0.90, "priority": 30, "knowledge_type": "heuristic", "rationale": "High fever + ≥2 dengue symptoms", "source": "WHO"},
    {"id": "R8", "if": ["chills"], "then": "malaria_signs", "cf": 0.60, "priority": 30, "knowledge_type": "heuristic", "rationale": "Chills is one of the three most common early malaria symptoms (WHO)", "source": "WHO"},
    {"id": "R20", "if": ["sweating"], "then": "malaria_signs", "cf": 0.40, "priority": 30, "knowledge_type": "heuristic", "rationale": "Sweating stage of the malaria paroxysm; weak evidence on its own", "source": "WHO"},
    {"id": "R9", "if": ["headache", "nausea_vomiting"], "then": "malaria_signs", "cf": 0.60, "priority": 30, "knowledge_type": "heuristic", "rationale": "Early malaria symptoms", "source": "WHO"},
    {"id": "R10", "if": ["fever", "malaria_signs"], "then": "malaria", "cf": 0.90, "priority": 30, "knowledge_type": "heuristic", "rationale": "Fever + malaria signs", "source": "WHO"},
    {"id": "R11", "if": ["fever", "fever_more_than_3_days"], "then": "prolonged_fever", "cf": 0.90, "priority": 20, "knowledge_type": "heuristic", "rationale": "Lecture heuristic: fever 3+ days → test for infection", "source": "Lecture heuristic"},
    {"id": "R12", "if": ["abdominal_pain", "diarrhea_or_constipation"], "then": "typhoid_signs", "cf": 0.75, "priority": 20, "knowledge_type": "heuristic", "rationale": "Typhoid GI pattern", "source": "WHO"},
    {"id": "R13", "if": ["prolonged_fever", "typhoid_signs"], "then": "typhoid", "cf": 0.85, "priority": 20, "knowledge_type": "heuristic", "rationale": "Prolonged high fever + GI symptoms", "source": "WHO"},
    {"id": "R14", "if": ["cough", "body_aches"], "then": "flu_signs", "cf": 0.70, "priority": 20, "knowledge_type": "heuristic", "rationale": "Dry cough + muscle pain", "source": "WHO"},
    {"id": "R15", "if": ["headache", "fatigue"], "then": "flu_signs", "cf": 0.50, "priority": 20, "knowledge_type": "heuristic", "rationale": "Headache + severe malaise", "source": "WHO"},
    {"id": "R16", "if": ["fever", "flu_signs"], "then": "influenza", "cf": 0.85, "priority": 20, "knowledge_type": "heuristic", "rationale": "Sudden fever + flu signs; cf. CDC ILI definition", "source": "WHO"},
    {"id": "R17", "if": ["runny_nose", "sneezing"], "then": "cold_signs", "cf": 0.80, "priority": 10, "knowledge_type": "heuristic", "rationale": "Typical cold pattern", "source": "CDC"},
    {"id": "R18", "if": ["sore_throat"], "then": "cold_signs", "cf": 0.50, "priority": 10, "knowledge_type": "heuristic", "rationale": "Sore throat", "source": "CDC"},
    {"id": "R19", "if": ["cold_signs"], "then": "common_cold", "cf": 0.80, "priority": 10, "knowledge_type": "heuristic", "rationale": "Most colds have no fever", "source": "CDC"}
  ],
  "red_flags": [
    {"id": "RF1", "if": ["bleeding_gums"], "priority": 100, "message": "Bleeding gums or nose can be a warning sign of severe dengue. Seek emergency medical care now.", "knowledge_type": "factual", "source": "WHO, CDC"},
    {"id": "RF2", "if": ["chest_pain", "shortness_of_breath"], "priority": 100, "message": "Chest pain with shortness of breath needs urgent assessment. Seek emergency medical care now.", "knowledge_type": "factual", "source": "WHO (pneumonia)"},
    {"id": "RF3", "if": ["confusion"], "priority": 100, "message": "Confusion or reduced consciousness can signal a severe infection such as severe malaria. Seek emergency medical care now.", "knowledge_type": "factual", "source": "WHO (malaria, pneumonia)"}
  ]
